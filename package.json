  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "files": [
    "asy.js",
    "lib/",
    "asy",
    "asy.bat",
    "docs/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node asy.js",
    "help": "node asy.js help"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HTwoOhwater/anyshare-university-cli.git"
  },
  "bugs": {
    "url": "https://github.com/HTwoOhwater/anyshare-university-cli/issues"
  },
